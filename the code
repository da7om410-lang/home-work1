# Number Guessing Game
import random


def get_number(prompt):
    """Ask until the user types a valid whole number (input check)."""
    while True:
        try:
            return int(input(prompt))
        except ValueError:
            print("Please enter a valid number.")


def play():
    secret = random.randint(1, 100)
    tries = 0
    print("I picked a number from 1 to 100. Guess it!")
    while True:
        guess = get_number("Your guess: ")
        tries += 1
        if guess < secret:
            print("Too low!")
        elif guess > secret:
            print("Too high!")
        else:
            print(f"Correct! You won in {tries} tries.")
            break


if __name__ == "__main__":
    play()
